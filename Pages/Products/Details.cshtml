@page
@model Ecommerce.Pages.Products.DetailsModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<style>
    body {
        font-family: 'Amazon Ember', Arial, sans-serif;
        background-color: #eaeded;
    }

    .product-details-container {
        max-width: 1500px;
        margin: 20px auto;
        background-color: #fff;
        padding: 20px;
        border-radius: 4px;
    }

    .breadcrumb-nav {
        font-size: 12px;
        margin-bottom: 20px;
        color: #565959;
    }

        .breadcrumb-nav a {
            color: #007185;
            text-decoration: none;
        }

            .breadcrumb-nav a:hover {
                color: #c45500;
                text-decoration: underline;
            }

    .product-main {
        display: grid;
        grid-template-columns: 500px 1fr 300px;
        gap: 30px;
        margin-bottom: 30px;
    }

    /* Left Column - Image */
    .product-image-section {
        position: sticky;
        top: 20px;
        height: fit-content;
    }

    .main-image-container {
        background-color: #f7f7f7;
        padding: 40px;
        border: 1px solid #ddd;
        border-radius: 4px;
        text-align: center;
        margin-bottom: 15px;
    }

        .main-image-container img {
            max-width: 100%;
            max-height: 500px;
            object-fit: contain;
        }

    /* Middle Column - Details */
    .product-info-section {
        padding: 0 20px;
    }

    .product-title {
        font-size: 24px;
        font-weight: 400;
        line-height: 1.3;
        color: #0f1111;
        margin-bottom: 10px;
    }

    .product-rating {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
        font-size: 14px;
    }

    .stars {
        color: #ffa41c;
        font-size: 18px;
    }

    .rating-count {
        color: #007185;
    }

    .price-section {
        padding: 15px 0;
        border-top: 1px solid #e7e7e7;
        border-bottom: 1px solid #e7e7e7;
        margin: 15px 0;
    }

    .price-label {
        font-size: 14px;
        color: #565959;
        margin-bottom: 5px;
    }

    .product-price {
        font-size: 28px;
        color: #b12704;
        font-weight: 400;
    }

    .price-symbol {
        font-size: 16px;
        vertical-align: super;
    }

    .product-features {
        margin: 20px 0;
    }

        .product-features h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .product-features ul {
            list-style: disc;
            padding-left: 25px;
            line-height: 1.8;
        }

    .product-description {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e7e7e7;
    }

        .product-description h3 {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 10px;
        }

        .product-description p {
            line-height: 1.6;
            color: #0f1111;
        }

    .product-meta {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e7e7e7;
        font-size: 14px;
        color: #565959;
    }

        .product-meta .meta-row {
            display: grid;
            grid-template-columns: 150px 1fr;
            margin-bottom: 8px;
        }

        .product-meta .meta-label {
            font-weight: 600;
        }

    /* Right Column - Buy Box */
    .buy-box {
        border: 1px solid #d5d9d9;
        border-radius: 8px;
        padding: 20px;
        background-color: #fff;
        position: sticky;
        top: 20px;
        height: fit-content;
    }

    .buy-box-price {
        font-size: 28px;
        color: #b12704;
        margin-bottom: 10px;
    }

    .shipping-info {
        font-size: 14px;
        color: #007600;
        margin-bottom: 15px;
    }

    .stock-status {
        font-size: 18px;
        margin-bottom: 15px;
        font-weight: 600;
    }

    .in-stock {
        color: #007600;
    }

    .low-stock {
        color: #b12704;
    }

    .out-of-stock {
        color: #b12704;
    }

    .quantity-section {
        margin-bottom: 15px;
    }

        .quantity-section label {
            display: block;
            font-weight: 600;
            margin-bottom: 5px;
            font-size: 14px;
        }

        .quantity-section select {
            width: 100%;
            padding: 8px;
            border: 1px solid #d5d9d9;
            border-radius: 8px;
            background-color: #f0f2f2;
        }

    .add-to-cart-btn {
        width: 100%;
        background-color: #ffd814;
        border: 1px solid #fcd200;
        padding: 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 10px;
        transition: background-color 0.2s;
    }

        .add-to-cart-btn:hover:not(:disabled) {
            background-color: #f7ca00;
        }

        .add-to-cart-btn:disabled {
            background-color: #ddd;
            border-color: #aaa;
            cursor: not-allowed;
            color: #888;
        }

    .buy-now-btn {
        width: 100%;
        background-color: #ffa41c;
        border: 1px solid #ff8f00;
        padding: 12px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 15px;
        transition: background-color 0.2s;
    }

        .buy-now-btn:hover {
            background-color: #fa8900;
        }

    .security-badges {
        padding-top: 15px;
        border-top: 1px solid #e7e7e7;
        font-size: 12px;
        color: #565959;
    }

        .security-badges p {
            margin-bottom: 8px;
        }

    .back-link {
        display: inline-block;
        margin-bottom: 20px;
        color: #007185;
        text-decoration: none;
        font-size: 14px;
    }

        .back-link:hover {
            color: #c45500;
            text-decoration: underline;
        }

    .category-badge {
        display: inline-block;
        background-color: #f0f2f2;
        padding: 5px 12px;
        border-radius: 4px;
        font-size: 12px;
        color: #0f1111;
        margin-bottom: 10px;
    }

    @@media (max-width: 1200px) {
        .product-main {
            grid-template-columns: 1fr;
        }

        .buy-box {
            position: relative;
            top: 0;
        }
    }

    .alert {
        padding: 15px 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }

    .view-count {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        background-color: #f0f2f2;
        border-radius: 20px;
        font-size: 13px;
        color: #565959;
        margin-left: 10px;
    }

        .view-count i {
            color: #ff6b00;
        }
</style>

<div class="product-details-container">
    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Breadcrumb -->
    <div class="breadcrumb-nav">
        <a asp-page="/Index">Home</a>
        <span> › </span>
        <a asp-page="/Products/Index">Products</a>
        <span> › </span>
        @if (Model.Product.Category != null)
        {
            <a asp-page="/Products/Index" asp-route-categoryId="@Model.Product.CategoryId">@Model.Product.Category.Name</a>
            <span> › </span>
        }
        <span>@Model.Product.Name</span>
    </div>

    <!-- Main Product Section -->
    <div class="product-main">
        <!-- Left: Image -->
        <div class="product-image-section">
            <div class="main-image-container">
                @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                {
                    <img src="@Model.Product.ImageUrl"
                         alt="@Model.Product.Name"
                         onerror="this.onerror=null; this.src='https://via.placeholder.com/500x500?text=No+Image';">
                }
                else
                {
                    <img src="https://via.placeholder.com/500x500?text=No+Image" alt="@Model.Product.Name">
                }
            </div>
        </div>

        <!-- Middle: Product Info -->
        <div class="product-info-section">
            <a asp-page="/Products/Index" class="back-link">
                ‹ Back to Products
            </a>

            @if (Model.Product.Category != null)
            {
                <div class="category-badge">
                    <i class="bi bi-tag"></i> @Model.Product.Category.Name
                </div>
            }

            <h1 class="product-title">@Model.Product.Name</h1>

            <div class="product-rating">
                <span class="stars">★★★★☆</span>
                <span class="rating-count">4.5 out of 5 stars</span>
                <span>|</span>
                <a href="#reviews" style="color: #007185;">256 ratings</a>
                <span class="view-count">
                    <i class="bi bi-eye-fill"></i>
                    <strong>@Model.ViewCount</strong> views
                </span>
            </div>

            <div class="price-section">
                <div class="price-label">Price:</div>
                <div class="product-price">
                    <span class="price-symbol">$</span>@Model.Product.Price.ToString("N2")
                </div>
            </div>

            <div class="product-features">
                <h3>About this item</h3>
                <ul>
                    <li>@Model.Product.Description</li>
                    @if (Model.Product.Stock > 0)
                    {
                        <li>Available in stock - Ready to ship</li>
                    }
                    <li>Free shipping on orders over $25</li>
                    <li>Easy returns within 30 days</li>
                    <li>Secure payment options</li>
                </ul>
            </div>

            <div class="product-description">
                <h3>Product Description</h3>
                <p>@Model.Product.Description</p>
            </div>

            <div class="product-meta">
                <div class="meta-row">
                    <span class="meta-label">Category:</span>
                    <span>@(Model.Product.Category?.Name ?? "Uncategorized")</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Stock Available:</span>
                    <span>@Model.Product.Stock units</span>
                </div>
                <div class="meta-row">
                    <span class="meta-label">Product ID:</span>
                    <span>#@Model.Product.Id</span>
                </div>
                @if (Model.Product.CreatedAt != DateTime.MinValue)
                {
                    <div class="meta-row">
                        <span class="meta-label">Date First Available:</span>
                        <span>@Model.Product.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                }
            </div>
        </div>

        <!-- Right: Buy Box -->
        <div class="buy-box">
            <div class="buy-box-price">
                $@Model.Product.Price.ToString("N2")
            </div>

            <div class="shipping-info">
                <i class="bi bi-truck"></i> FREE delivery on your first order
            </div>

            @if (Model.Product.Stock > 10)
            {
                <div class="stock-status in-stock">
                    <i class="bi bi-check-circle"></i> In Stock
                </div>
            }
            else if (Model.Product.Stock > 0)
            {
                <div class="stock-status low-stock">
                    <i class="bi bi-exclamation-triangle"></i> Only @Model.Product.Stock left in stock - order soon
                </div>
            }
            else
            {
                <div class="stock-status out-of-stock">
                    <i class="bi bi-x-circle"></i> Currently unavailable
                </div>
            }

            @if (Model.Product.Stock > 0)
            {
                <form method="post" asp-page-handler="AddToCart">
                    <input type="hidden" name="productId" value="@Model.Product.Id" />

                    <div class="quantity-section">
                        <label for="quantity">Quantity:</label>
                        <select name="quantity" id="quantity" class="form-select">
                            @for (int i = 1; i <= Math.Min(Model.Product.Stock, 10); i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>

                    <button type="submit" class="add-to-cart-btn">
                        <i class="bi bi-cart-plus"></i> Add to Cart
                    </button>
                </form>

                <button class="buy-now-btn" onclick="alert('Buy Now functionality coming soon!')">
                    <i class="bi bi-lightning-fill"></i> Buy Now
                </button>
            }
            else
            {
                <button class="add-to-cart-btn" disabled>
                    <i class="bi bi-x-circle"></i> Out of Stock
                </button>
            }

            <div class="security-badges">
                <p><i class="bi bi-shield-check"></i> <strong>Secure transaction</strong></p>
                <p><i class="bi bi-arrow-return-left"></i> <strong>Easy returns</strong></p>
                <p><i class="bi bi-truck"></i> <strong>Fast shipping</strong></p>
            </div>
        </div>
    </div>

    <!-- Additional Information Section -->
    <div style="margin-top: 30px; padding-top: 30px; border-top: 1px solid #e7e7e7;">
        <h2 style="font-size: 20px; margin-bottom: 20px;">Product Specifications</h2>
        <table class="table table-borderless" style="max-width: 800px;">
            <tbody>
                <tr>
                    <td style="width: 200px; color: #565959; font-weight: 600;">Product Name</td>
                    <td>@Model.Product.Name</td>
                </tr>
                <tr>
                    <td style="color: #565959; font-weight: 600;">Category</td>
                    <td>@(Model.Product.Category?.Name ?? "Uncategorized")</td>
                </tr>
                <tr>
                    <td style="color: #565959; font-weight: 600;">Price</td>
                    <td>$@Model.Product.Price.ToString("N2")</td>
                </tr>
                <tr>
                    <td style="color: #565959; font-weight: 600;">Availability</td>
                    <td>
                        @if (Model.Product.Stock > 0)
                        {
                            <span style="color: #007600; font-weight: 600;">In Stock (@Model.Product.Stock units available)</span>
                        }
                        else
                        {
                            <span style="color: #b12704; font-weight: 600;">Out of Stock</span>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-hide success message
        setTimeout(function () {
            var alert = document.querySelector('.alert-success');
            if (alert) {
                alert.style.display = 'none';
            }
        }, 3000);
    </script>
}
